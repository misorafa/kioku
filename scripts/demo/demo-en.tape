# kioku demo (ja) — rendered by VHS against a throwaway local server
Output kioku-demo-en.gif
Output kioku-demo-en.mp4
Set Shell zsh
Set FontFamily "JetBrains Mono, Menlo, Hiragino Sans"
Set FontSize 15
Set Width 1320
Set Height 1040
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Env HOME "@SANDBOX@/home-en"
Env PATH "@SANDBOX@/bin:@CARGOBIN@:/opt/homebrew/bin:/usr/bin:/bin"
Hide
Type "cd @SANDBOX@/repo-en && setopt interactivecomments && export PS1='%F{cyan}demo-shop%f %# ' && clear"
Enter
Show
Sleep 800ms
Type "# Yesterday: Claude Code on the Mac. Today: Codex on the Windows PC picked it up."
Enter
Sleep 1800ms
Type 'kioku search "email validation"'
Sleep 500ms
Enter
Sleep 5s
Type "clear"
Enter
Type "# Whatever agent starts the next session receives this:"
Enter
Sleep 1200ms
Type "next-session-en"
Sleep 400ms
Enter
Sleep 9s
Screenshot frame-en-end.png
Sleep 1s
